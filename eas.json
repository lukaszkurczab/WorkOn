{
  "cli": {
    "version": ">= 5.9.1"
  },
  "build": {
    "development": {
      "env": {
        "EXPO_PUBLIC_BASE_URL": "http://192.168.1.100:8080"
      },
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "channel": "preview",
      "env": {
        "APP_NAME": "WorkOn",
        "EXPO_PUBLIC_BASE_URL": "https://workon-backend-production.up.railway.app"
      }
    },
    "production": {
      "env": {
        "APP_NAME": "WorkOn",
        "EXPO_PUBLIC_BASE_URL": "https://workon-backend-production.up.railway.app"
      },
      "channel": "production",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
